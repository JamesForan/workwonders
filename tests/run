#!/usr/bin/env node
// Runs BearingsModel.layout against recorded hyprctl output in
// fixtures/<case>/input.json (plus options.json if present) and compares the
// result with fixtures/<case>/expected.json.
//
//   tests/run            check every case
//   tests/run --update   rewrite expected.json from the current output
//
// Needs only node; never touches the running session.

const fs = require("fs")
const path = require("path")
const model = require("../BearingsModel.js")

const update = process.argv.includes("--update")
const root = path.join(__dirname, "fixtures")
let failed = 0

for (const name of fs.readdirSync(root).sort()) {
  const dir = path.join(root, name)
  const input = JSON.parse(fs.readFileSync(path.join(dir, "input.json"), "utf8"))
  const optionsFile = path.join(dir, "options.json")
  const options = fs.existsSync(optionsFile) ? JSON.parse(fs.readFileSync(optionsFile, "utf8")) : {}
  const actual = JSON.stringify(model.layout(input, options), null, 2) + "\n"
  const expectedFile = path.join(dir, "expected.json")

  if (update) {
    fs.writeFileSync(expectedFile, actual)
    console.log(`updated ${name}`)
    continue
  }
  const expected = fs.existsSync(expectedFile) ? fs.readFileSync(expectedFile, "utf8") : ""
  if (actual === expected) {
    console.log(`ok   ${name}`)
  } else {
    failed++
    console.log(`FAIL ${name}`)
    console.log(actual)
  }
}

// forScreen: "own" keeps only this bar's monitor, falling back to all.
const groups = [{ monitor: "eDP-1" }, { monitor: "DP-1" }]
const own = model.forScreen(groups, "own", "DP-1")
const missing = model.forScreen(groups, "own", "HDMI-A-1")
if (own.length !== 1 || own[0].monitor !== "DP-1" || missing.length !== 2 || model.forScreen(groups, "all", "DP-1").length !== 2) {
  failed++
  console.log("FAIL forScreen")
} else if (!update) {
  console.log("ok   forScreen")
}

process.exit(failed ? 1 : 0)
